# Copia este archivo a `.env` y pega tu API key de Anthropic para activar el tutor con IA.
#   cp .env.example .env
# El .env NO se comparte (está en .gitignore). La key vive solo en el servidor local,
# nunca llega al navegador.

ANTHROPIC_API_KEY=sk-ant-...

# Opcional: cambia el modelo (por defecto claude-opus-4-8).
# CENEVAL_MODELO=claude-opus-4-8

# Muy recomendado si el sitio queda expuesto en una URL pública (p. ej. Railway):
# sin esto, cualquiera con el link puede usar el tutor con IA y drenar la API key.
# Con esto, el navegador pide este código una sola vez (widget del tutor) y lo
# guarda en localStorage; el servidor lo exige en cada petición a /api/tutor.
# TUTOR_ACCESS_CODE=elige-un-código-solo-tú-lo-sabes
