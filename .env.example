# Copia este archivo a `.env` y pega tu API key de Anthropic para activar el tutor con IA.
#   cp .env.example .env
# El .env NO se comparte (está en .gitignore). La key vive solo en el servidor local,
# nunca llega al navegador.

ANTHROPIC_API_KEY=sk-ant-...

# Opcional: cambia el modelo (por defecto claude-opus-4-8).
# CENEVAL_MODELO=claude-opus-4-8

# Recomendado si el sitio va a ser de uso personal (p. ej. desplegado en Railway):
# pide este password una sola vez (pantalla de login, sin usuario) para TODO el
# sitio, y guarda la sesión en una cookie por 30 días. Si lo configuras, ya no
# necesitas TUTOR_ACCESS_CODE — nadie llega ni al tutor sin pasar por aquí.
# APP_PASSWORD=elige-un-password-solo-tú-lo-sabes

# Alternativa/complemento: deja el sitio abierto pero protege solo el tutor con
# IA (por ejemplo si quieres compartir los simulacros con más gente, pero no
# que usen tu API key). El navegador lo pide una sola vez y lo guarda en
# localStorage; el servidor lo exige en cada petición a /api/tutor.
# TUTOR_ACCESS_CODE=elige-un-código-solo-tú-lo-sabes
